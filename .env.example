# .env.example

# Drizzle / Postgres-Verbindung
# Supabase Dashboard: Project Settings -> Database -> Connection string -> "Transaction pooler"
# (Port 6543). Auf Netlify/serverlos bitte den Pooler nutzen, nicht die direkte
# Verbindung (Port 5432) - sonst laufen euch die Connections weg.
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<projekt-ref>:<passwort>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres"

# Supabase Client (für Auth, nächster Schritt nach dem DB-Setup)
# Supabase Dashboard: Project Settings -> API
PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# Täglicher Spielplan-Sync (Netlify Scheduled Function -> /api/cron/spielplan-sync)
# Gemeinsames Geheimnis für den Cron-Endpoint, z. B. erzeugen mit: openssl rand -hex 32
# Ohne Wert antwortet der Endpoint mit 503. In Netlify als Umgebungsvariable setzen.
CRON_SECRET=""
# Nur nötig, falls Netlify die Variable URL nicht setzt (z. B. lokal): Basis-URL der App
SITE_BASE_URL=""
